# Copy to terraform.tfvars and fill in.
# terraform.tfvars is gitignored; this example is not.

## Common

# Guard rail: apply fails if the caller is not this account.
management_account_id = "000000000000"

# Optional, defaults to eu-west-1.
# region = "eu-west-1"

## Accounts

# Root email of the shared services account. Must be unique across all AWS
# accounts and not already used to sign up anywhere. Changing it after creation
# replaces the account, so prefer an alias you control (e.g. a distribution list).
shared_services_email = "aws-shared-services@example.com"

## Identity Center

# Email of the Identity Center admin user. Receives the password-setup
# invitation and any MFA recovery mail.
admin_email = "you@example.com"
