# Copy to terraform.tfvars and fill in.
# terraform.tfvars is gitignored; this example is not.

## Common

# Guard rail: apply fails if the caller is not this account.
shared_services_account_id = "000000000000"

# Optional, defaults to eu-west-1.
# region = "eu-west-1"

## DNS

# Subdomain delegated from the apex zone at the external DNS provider, for the
# homelab cluster. The apex is edited by hand and holds the account recovery MX
# records, so only this subdomain is delegated into AWS. Records inside the zone
# are managed by the cluster's own repository, not here.
homelab_zone_name = "homelab.example.com"

## Mail zones

# Apex zones for domains registered in this account, per decision 13. Mail
# records only: nothing automated ever writes into these.
#
# Adding an entry creates a zone but changes nothing about resolution. The zone
# is inert until the registration's nameservers are repointed at its delegation
# set, which is deliberate: it lets a new zone be built and verified while the
# old one is still serving. See the migration procedure in the runbooks.
#
# ttl defaults to 60 and txt to an empty list.
# auto_renew defaults to true and transfer_lock to false. Set auto_renew
# explicitly on anything you intend to keep: it is the setting that fails
# silently, a year later, on a date nobody is watching.
mail_zones = {
  "example.com" = {
    mx            = ["10 mx1.mail.example.net", "20 mx2.mail.example.net"]
    txt           = ["provider-verification=replace-me"]
    transfer_lock = true
  }
}

# Domains registered here with no hosted zone here. Their nameservers are left
# unmanaged, because there is nothing in this account to point them at.
unserved_domains = {
  "example.net" = { auto_renew = false, transfer_lock = false }
}
